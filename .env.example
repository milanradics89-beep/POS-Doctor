# USEIT frontend
# Public runtime API base URL. Do not put secrets in Expo environment variables.
# Required by remote Codemagic/App Preview builds. Set a deployed HTTPS URL in Codemagic Environment Variables.
EXPO_PUBLIC_USEIT_API_URL=
# Public Google Cloud project number used by the Android Play Integrity client.
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=
