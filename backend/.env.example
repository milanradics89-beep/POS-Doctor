# USEIT backend - server-side secrets only
OPENAI_API_KEY=
# Optional server-to-server credential. Never ship this value in the mobile app.
USEIT_API_KEY=
# Required for the public/native mobile session flow in production.
USEIT_SESSION_SECRET=replace-with-a-random-32-plus-character-secret
USEIT_SESSION_TTL_SECONDS=900
# Platform attestation policy: disabled, optional, or required.
# Keep disabled until Apple App Attest / Google Play Integrity verification is configured server-side.
USEIT_ATTESTATION_MODE=disabled
# Provider and app identity used by the server-issued attestation challenge.
USEIT_ATTESTATION_PROVIDER=apple_app_attest
USEIT_ATTESTATION_APP_ID=
# Challenge lifetime is intentionally short and challenges are single-use.
USEIT_ATTESTATION_CHALLENGE_TTL_SECONDS=300
USEIT_VISION_MODEL=gpt-4.1
USEIT_IMAGE_MODEL=gpt-image-2
GOOGLE_WEB_SEARCH_API_KEY=
GOOGLE_WEB_SEARCH_CLIENT_ID=
# Comma-separated browser origins. Native Expo clients do not use browser CORS.
USEIT_CORS_ORIGINS=https://app.example.com
USEIT_ENV=production
USEIT_ALLOW_DOCS=false
USEIT_RATE_LIMIT_PER_MINUTE=60
USEIT_SESSION_RATE_LIMIT_PER_MINUTE=10
# Use redis for multi-instance deployments.
USEIT_RATE_LIMIT_MODE=redis
USEIT_REDIS_URL=redis://:password@redis.example.internal:6379/0
USEIT_LOG_LEVEL=INFO
