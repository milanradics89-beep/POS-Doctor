# USEIT backend - server-side secrets only
OPENAI_API_KEY=
USEIT_API_KEY=
USEIT_VISION_MODEL=gpt-4.1
USEIT_IMAGE_MODEL=gpt-image-2
GOOGLE_WEB_SEARCH_API_KEY=
GOOGLE_WEB_SEARCH_CLIENT_ID=
