{
  "expo": {
    "name": "USEIT",
    "slug": "useit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "useit",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.useit.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F2"
      }
    },
    "ios": {
      "bundleIdentifier": "com.useit.app",
      "supportsTablet": true
    }
  }
}
