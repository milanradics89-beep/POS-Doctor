{
  "expo": {
    "name": "USEIT",
    "slug": "useit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "useit",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "A USEIT hozzáférést kér a fotóidhoz, hogy kiválaszthasd az elemzéshez használni kívánt képet.",
          "cameraPermission": "A USEIT a kamerád használatára kér engedélyt, hogy fotót készíthess az elemzéshez.",
          "microphonePermission": false
        }
      ],
      "./modules/useit-app-attest/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.useit.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F2"
      }
    },
    "ios": {
      "bundleIdentifier": "com.useit.app",
      "supportsTablet": true
    }
  }
}
